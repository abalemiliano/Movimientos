<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Material 3 semantic palette LightTheme -->
    <Color x:Key="Primary">#0a009e</Color>
    <Color x:Key="OnPrimary">#ffffff</Color>
    <Color x:Key="PrimaryContainer">#2828c7</Color>
    <Color x:Key="OnPrimaryContainer">#ffffff</Color>

    <Color x:Key="Secondary">#002f47</Color>
    <Color x:Key="OnSecondary">#ffffff</Color>
    <Color x:Key="SecondaryContainer">#004e72</Color>
    <Color x:Key="OnSecondaryContainer">#ffffff</Color>

    <Color x:Key="Tertiary">#182f3a</Color>
    <Color x:Key="OnTertiary">#ffffff</Color>
    <Color x:Key="TertiaryContainer">#364c58</Color>
    <Color x:Key="OnTertiaryContainer">#ffffff</Color>

    <Color x:Key="Error">#600004</Color>
    <Color x:Key="OnError">#ffffff</Color>
    <Color x:Key="ErrorContainer">#98000b</Color>
    <Color x:Key="OnErrorContainer">#ffffff</Color>

    <Color x:Key="SurfaceLight">#fcf8ff</Color>
    <Color x:Key="SurfaceContainerLight">#b9b7c3</Color>
    <Color x:Key="SurfaceVariantLight">#f2effc</Color>
    <Color x:Key="OnSurfaceLight">#000000</Color>
    <Color x:Key="OnSurfaceVariantLight">#000000</Color>
    <Color x:Key="OutlineLight">#2b2b39</Color>
    <Color x:Key="OutlineVariantLight">#484857</Color>

    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLight}"/>
    <SolidColorBrush x:Key="SurfaceContainerLightBrush" Color="{StaticResource SurfaceContainerLight}"/>

    <!-- Material 3 semantic palette LightTheme -->
    <Color x:Key="PrimaryDark">#1B1B88</Color>
    <Color x:Key="OnPrimaryDark">#0C0C3C</Color>
    <Color x:Key="PrimaryContainerDark">#1B1B88</Color>
    <Color x:Key="OnPrimaryContainerDark">#EADDFF</Color>

    <Color x:Key="SecondaryDark">#CCC2DC</Color>
    <Color x:Key="OnSecondaryDark">#3A505C</Color>
    <Color x:Key="SecondaryContainerDark">#4A4458</Color>
    <Color x:Key="OnSecondaryContainerDark">#E8DEF8</Color>

    <Color x:Key="TertiaryDark">#EFB8C8</Color>
    <Color x:Key="OnTertiaryDark">#492532</Color>
    <Color x:Key="TertiaryContainerDark">#633B48</Color>
    <Color x:Key="OnTertiaryContainerDark">#ffffff</Color>

    <Color x:Key="SurfaceDark">#141218</Color>
    <Color x:Key="SurfaceContainerDark">#211F26</Color>
    <Color x:Key="SurfaceVariantDark">#49454F</Color>
    <Color x:Key="OnSurfaceDark">#E6E0E9</Color>
    <Color x:Key="OnSurfaceVariantDark">#CAC4D0</Color>
    <Color x:Key="OutlineDark">#938F99</Color>
    <Color x:Key="OutlineVariantDark">#49454F</Color>

    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDark}"/>
    <SolidColorBrush x:Key="SurfaceContainerDarkBrush" Color="{StaticResource SurfaceContainerDark}"/>

    <!-- Propios de la aplicacion -->
    <Color x:Key="PrimaryDarkText">#0C0C3C</Color>
    <Color x:Key="SecondaryDarkText">#1B6288</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E7E7E7</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>